<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                   http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="4" author="shreya">

        <createTable tableName="booking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="flight_id" type="BIGINT"/>
            <column name="user_id" type="UUID"/>

            <column name="seat_number" type="VARCHAR(10)"/>
            <column name="seat_class" type="VARCHAR(50)"/>
            <column name="price_paid" type="DECIMAL(10,2)"/>
            <column name="booking_status" type="VARCHAR(50)"/>
            <column name="payment_status" type="VARCHAR(50)"/>

            <column name="booking_time" type="TIMESTAMP"/>
        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint
                baseTableName="booking"
                baseColumnNames="flight_id"
                referencedTableName="flight"
                referencedColumnNames="id"
                constraintName="fk_booking_flight"/>

        <addForeignKeyConstraint
                baseTableName="booking"
                baseColumnNames="user_id"
                referencedTableName="user"
                referencedColumnNames="id"
                constraintName="fk_booking_user"/>

    </changeSet>

</databaseChangeLog>